# ============================================================
# H1 VPMS — Environment Configuration
#
# 28 variables are read by the application. Everything marked
# REQUIRED must be set or the relevant feature fails at runtime.
# ============================================================

# ── Supabase (REQUIRED) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only. Bypasses RLS — never expose to the client.
# Used by the vendor OTP routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── App (REQUIRED) ──────────────────────────────────────────
# Absolute base URL. Used in PDFs, emails and vendor portal links.
NEXT_PUBLIC_APP_URL=https://vendor.health1.in

# ── Cron (REQUIRED for scheduled jobs) ──────────────────────
# Shared secret for /api/cron/daily. Without it the daily job
# (payment reminders, document expiry, reorder checks) is unprotected.
CRON_SECRET=

# ── HMIS bridge (REQUIRED for HMIS integration) ─────────────
# Shared secret for /api/bridge/* — indent, consumption, billing, items.
HMIS_BRIDGE_SECRET=

# ── Rate limiting (recommended) ─────────────────────────────
# Without Upstash, rate limiting degrades to in-memory and will
# not hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email / SMTP (required for notifications by email) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@health1.in

# ── WhatsApp (choose ONE provider) ──────────────────────────
# Set WHATSAPP_PROVIDER to: meta | gupshup | interakt | wati
# NOTE: four providers are currently implemented. Pick one and
# delete the rest — see the go-live notes.
WHATSAPP_PROVIDER=

# Meta Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Gupshup
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=

# Interakt
INTERAKT_API_KEY=

# WATI
WATI_API_URL=
WATI_API_KEY=

# ── Tally (required for Tally sync) ─────────────────────────
# URL of the on-prem Tally connector for the centre.
TALLY_SERVER_URL=

# ── OCR / AI invoice extraction (optional) ──────────────────
ANTHROPIC_API_KEY=

# ── Seeding (development only) ──────────────────────────────
# Must be 'true' to allow /api/seed. Leave unset in production.
ALLOW_SEED=

# ── Sentry (recommended) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
